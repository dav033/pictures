{
  "name": "demo-decoracion",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "node scripts/next-with-system-ca.cjs dev",
    "build": "next build",
    "start": "node scripts/next-with-system-ca.cjs start",
    "lint": "eslint",
    "rag:stack-check": "tsx scripts/stack-check.ts",
    "rag:migrate": "tsx scripts/migrate.ts",
    "rag:health": "tsx scripts/rag-health.ts",
    "rag:import": "tsx scripts/import-shopify-catalog.ts",
    "rag:embed": "tsx scripts/generate-embeddings.ts",
    "rag:sync": "npm run rag:import && npm run rag:embed",
    "rag:eval": "tsx scripts/eval-retrieval.ts",
    "rag:eval-presupuesto": "tsx scripts/eval-presupuesto.ts",
    "rag:eval-parser": "tsx scripts/eval-query-parser.ts",
    "rag:eval-chat": "tsx --env-file=.env.local --conditions=react-server scripts/eval-chat-thinking.ts",
    "rag:test-validation": "tsx scripts/test-rag-validation.ts",
    "rag:test-webhook": "tsx scripts/test-webhook.ts",
    "rag:metrics": "tsx scripts/rag-metrics.ts",
    "rag:regression": "tsx scripts/regression-anti-alucinacion.ts",
    "catalog:enrich": "tsx scripts/enrich-shopify-catalog.ts",
    "dataset:select-products": "tsx scripts/select-sempertex-training-products.ts",
    "dataset:select-mixed": "tsx scripts/select-sempertex-mixed-training-dataset.ts",
    "dataset:select-final": "tsx scripts/select-sempertex-final-training-dataset.ts",
    "dataset:download-products": "tsx scripts/download-sempertex-training-images.ts",
    "dataset:download-mixed": "tsx scripts/download-sempertex-training-images.ts --input data/processed/sempertex-training-mixed-selection-v001.json --output-dir data/raw/sempertex-mixed-v001 --database data/processed/sempertex-training-database-v001.json --captions data/processed/sempertex-training-captions-v001.jsonl",
    "dataset:download-final": "tsx scripts/download-sempertex-training-images.ts --input data/processed/sempertex-training-final-selection-v001.json --output-dir data/raw/sempertex-training-v001 --database data/processed/sempertex-training-final-database-v001.json --captions data/processed/sempertex-training-final-captions-v001.jsonl --dataset-version sempertex-training-v001 --minimum-short-side 512",
    "dataset:validate-final": "tsx scripts/validate-sempertex-training-dataset.ts",
    "dataset:package-final": "python scripts/package-fal-final-dataset.py",
    "dataset:build-pilot": "python scripts/build-sempertex-pilot-dataset.py",
    "dataset:build-full": "python scripts/build-sempertex-full-training-dataset.py",
    "ia:test": "tsx scripts/test-image-fidelity.ts",
    "ia:test-prompts": "tsx scripts/test-visual-prompts.ts",
    "ia:eval": "tsx scripts/eval-image-fidelity.ts",
    "dataset:validate": "tsx scripts/validate-dataset.ts",
    "dataset:prepare": "python scripts/prepare-sempertex-dataset.py",
    "dataset:finalize": "python scripts/finalize-dataset-manifest.py",
    "dataset:package-fal": "python scripts/package-fal-dataset.py"
  },
  "dependencies": {
    "@sempertex/agente-core": "*",
    "@google/genai": "^2.16.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "motion": "^13.1.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
