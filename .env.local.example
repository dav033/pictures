# Plantilla de .env.local con valores de ejemplo en todo lo sensible (2026-09-15).
# Copia este archivo a .env.local y reemplaza los ejemplos por tus valores reales.
# Neon es la única fuente de verdad: las URLs van entre comillas simples (llevan '&').

IA_PROVEEDOR=gemini

APP_PASSWORD=cambia-esta-clave

GEMINI_API_KEY=tu-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_CHAT_THINKING_LEVEL=low

# IA local con Claude Haiku (W5): cambia IA_PROVEEDOR=gemini (arriba) por IA_PROVEEDOR=claude y pon la llave.
# Solo funciona con NODE_ENV=development (next dev) y sin VERCEL: Vercel, el VPS, next start y los scripts sin
# NODE_ENV usan Gemini. Un script local con tsx necesita NODE_ENV=development explícito al lanzarlo (no aquí).
# Siguen en Gemini: embeddings y Happie.
ANTHROPIC_API_KEY=tu-anthropic-api-key
# Sin llave: IA_CLAUDE_TRANSPORTE=cli usa el Claude Code instalado (con tu sesión; lo paga la suscripción), modelo haiku,
# esfuerzo low por defecto (más rápido; medium si lo prefieres) y plazos ×4:
#   IA_PROVEEDOR=claude
#   IA_CLAUDE_TRANSPORTE=cli
# IA_CLAUDE_TRANSPORTE=api
# ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
# IA_LOCAL_ESFUERZO=medium
# IA_LOCAL_PENSAMIENTO=on

DATABASE_URL='postgresql://USUARIO:CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
CATALOG_DATABASE_URL='postgresql://USUARIO:CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
PLAN_APPROVAL_SECRET=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
RAG_ENABLED=true
RAG_VECTOR_LIMIT=30
RAG_FINAL_LIMIT=15
RAG_MIN_SIMILARITY=0.5
RAG_USE_FULLTEXT=true
RAG_USE_VECTOR=true
RAG_PYTHON_QUERY_EMBEDDINGS_ENABLED=true
PYTHON_BACKEND_ENABLED=true
PYTHON_BACKEND_KILL_SWITCH=false
PYTHON_BACKEND_URL=http://127.0.0.1:8000
INTERNAL_HMAC_SECRET=
SHOPIFY_WEBHOOK_SECRET=tu-secreto-de-webhook-shopify
FAL_KEY=tu-fal-key

HAPPIA_API_BASE_URL=https://api.ejemplo-happia.com
HAPPIA_API_KEY=tu-happia-api-key

HAPPIE_EXTERNO_API_KEY=tu-api-key-externa
HAPPIE_EXTERNO_ORIGENES=https://tu-dominio.com
HAPPIE_WEBHOOK_API_KEY=tu-api-key-de-webhook
# Solo desarrollo: no exige que la huella del plan aprobado coincida con la del
# plan re-resuelto al generar. Falla cerrado en producción (pide NODE_ENV
# =development). Iterar sobre el reparto de color mueve `plan_hash` en cada
# cambio y obligaría a reaprobar en cada recarga. Retirar cuando ese reparto se
# estabilice. El token sigue siendo obligatorio, y siguen vivas las puertas de
# presupuesto, cobertura y estimación de materiales.
APROBACION_SIN_HUELLA_PARA_PRUEBAS=false



# TEMPORAL: "true" entrega la imagen de Gemini aunque el QA visual no sea conforme (qa.pass=false) en vez de 422 IMAGEN_NO_FIEL.
IMAGE_QA_NON_BLOCKING=false
