{
  "name": "@sempertex/agente-core",
  "version": "0.1.0",
  "description": "Motor de tool-calling con LLM, adaptador de Gemini y utilidades de retrieval — sin nada específico del dominio de decoración. Extraído de demo-decoracion para reutilizarse con otra fuente de datos.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./gemini": {
      "types": "./dist/gemini/chat.d.ts",
      "require": "./dist/gemini/chat.js",
      "default": "./dist/gemini/chat.js"
    },
    "./rag": {
      "types": "./dist/rag/rrf.d.ts",
      "require": "./dist/rag/rrf.js",
      "default": "./dist/rag/rrf.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "dependencies": {
    "@google/genai": "^2.16.0"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
