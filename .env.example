# Safe local defaults only. Copy to .env.local and replace values as needed.
# Never put a production credential in this file or commit a populated .env.

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_only_change_me
POSTGRES_DB=rag
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rag:rag_local_only_change_me@127.0.0.1:5432/rag

# Optional: deterministic parsing/retrieval works without this key.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

RAG_ENABLED=false
RAG_USE_VECTOR=false
RAG_USE_FULLTEXT=true
RAG_VECTOR_LIMIT=30
RAG_FINAL_LIMIT=15
RAG_MIN_SIMILARITY=0.56
