# Safe local defaults only. Copy to .env.local and replace values as needed.
# Never put a production credential in this file or commit a populated .env.

# Login simple del sitio (cookie de sesion de 30 dias). Requerido en produccion.
APP_PASSWORD=

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_only_change_me
POSTGRES_DB=rag
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL='postgresql://USUARIO:CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# Python catalog authority uses a separate read-only role in production.
# Locally this can point to the same database while permissions are configured.
CATALOG_DATABASE_URL='postgresql://USUARIO:CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# Optional: deterministic parsing/retrieval works without this key.
GEMINI_API_KEY=
# Embedding contract is fixed in code: gemini-embedding-2 / 768 dimensions.

RAG_ENABLED=true
RAG_USE_VECTOR=true
RAG_USE_FULLTEXT=true
RAG_FINAL_LIMIT=15
RAG_USE_TRIGRAM=true
RAG_BRANCH_LIMIT=40
RAG_TRIGRAM_MIN_SIMILARITY=0.3
# Optional Fase 8.2: Python only reorders the already-whitelisted window.
RAG_RERANK_ENABLED=false
RAG_RERANK_CANDIDATE_WINDOW=30
RAG_RERANK_DEADLINE_MS=5000
# Optional online query embeddings via Python. Requires the Python backend flag.
RAG_PYTHON_QUERY_EMBEDDINGS_ENABLED=true

# Python operational boundary (keep disabled until each canary is accepted).
PYTHON_BACKEND_ENABLED=true
PYTHON_BACKEND_KILL_SWITCH=false
PYTHON_BACKEND_URL=http://127.0.0.1:8000
INTERNAL_HMAC_SECRET=

# Optional end-to-end decoration planner. Set false only as an incident rollback.
PLAN_DECORACION_ENABLED=true
IMAGE_QA_ENABLED=false
PLAN_APPROVAL_SECRET=
PLAN_COST_OPTIMIZER_V2=true
PLAN_BUDGET_GATE_V2=true
LORA_ARTIFACT_ROOT=data/lora-artifacts
# Directorio montado/runtime usado por órdenes admin y pipelines de dataset.
ORDENES_DECORACION_DIR=data/ordenes-decoracion

# Snapshot de estadisticas LoRA hacia el servidor (sin imagenes ni pesos).
# El contenedor corre con -v demo-decoracion-data:/app/data (volumen Docker
# nombrado), asi que se escribe con `docker cp` via ssh, no con scp directo
# al filesystem del host (el usuario ssh no tiene permiso sobre el volumen).
# LORA_SNAPSHOT_SSH_HOST: alias de ~/.ssh/config con acceso ya configurado (ej. n8n-maros).
# LORA_SNAPSHOT_DOCKER_CONTAINER: nombre del contenedor corriendo la app (ej. demo-decoracion).
# LORA_SNAPSHOT_CONTAINER_PATH: ruta dentro del contenedor (default /app/data/snapshot/lora-estado.json).
LORA_SNAPSHOT_SSH_HOST=
LORA_SNAPSHOT_DOCKER_CONTAINER=
LORA_SNAPSHOT_CONTAINER_PATH=
SCENE_PLAN_V2_SHADOW=false
SCENE_PLAN_V2_ENABLED=false
SCENE_PLAN_V2_REQUIRE_VERIFIED_SOURCES=true
SCENE_PLAN_V2_VISUAL_QA=false
SCENE_PLAN_V2_KILL_SWITCH=false

# --- happie-package-ia ---
HAPPIA_API_BASE_URL=https://www.happia.co/api
HAPPIA_API_KEY=

# Endpoints /api/happie/recommend-package(s) para un consumidor externo
# desde el navegador (no usan la cookie de sesion de la app, ver proxy.ts).
# HAPPIE_EXTERNO_ORIGENES: origenes permitidos separados por coma (sin barra final).
HAPPIE_EXTERNO_API_KEY=
HAPPIE_EXTERNO_ORIGENES=

# Endpoints /api/happie/webhook/recommend-package(s): version server-to-server
# (sin CORS) para que el backend de chat de Happia los llame directo.
# Secreto propio, distinto de HAPPIE_EXTERNO_API_KEY (ese viaja en JS de cliente).
# Minimo 32 caracteres aleatorios. Configurarlo también en la aplicación consumidora.
HAPPIE_WEBHOOK_API_KEY=
