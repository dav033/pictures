# Safe local defaults only. Copy to .env.local and replace values as needed.
# Never put a production credential in this file or commit a populated .env.

# Login simple del sitio (cookie de sesion de 30 dias). Requerido en produccion.
APP_PASSWORD=
# Orígenes públicos de la app, separados por coma (solo hace falta detrás de un proxy inverso; en desarrollo localhost y 127.0.0.1 valen solos)
APP_ORIGINS=

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_only_change_me
POSTGRES_DB=rag
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL='postgresql://USUARIO:CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# Python catalog authority uses a separate read-only role in production.
# Locally this can point to the same database while permissions are configured.
CATALOG_DATABASE_URL='postgresql://USUARIO:CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# Optional: deterministic parsing/retrieval works without this key.
GEMINI_API_KEY=
# Embedding contract is fixed in code: gemini-embedding-2 / 768 dimensions.

# IA local con Claude (W5). SOLO en local: el código exige NODE_ENV=development (lo pone `next dev`) y que no haya
# VERCEL; lo rechaza en Vercel, en el VPS (Docker con NODE_ENV=production), con `next start` y sin NODE_ENV.
# Se activa con IA_PROVEEDOR=claude más la llave; producción sigue con Gemini Flash.
# Scripts locales con tsx (p. ej. el arnés de W4): pon NODE_ENV=development explícito al lanzarlos, o corren con Gemini:
#   NODE_ENV=development npx tsx --env-file=.env.local --conditions=react-server scripts/...      (bash)
#   $env:NODE_ENV="development"; npx tsx --env-file=.env.local --conditions=react-server scripts/...  (PowerShell)
# No pongas NODE_ENV en este archivo ni en el .env del VPS.
# Siguen en Gemini aunque Claude esté activo: los embeddings (RAG, búsqueda por foto; deja GEMINI_API_KEY puesta) y
# Happie (recomendador y conversación del webhook).
# IA_PROVEEDOR=claude
# Llave de la API de Anthropic (solo .env.local; nunca en Vercel ni en el repo).
ANTHROPIC_API_KEY=
# Transporte: api (por defecto, con ANTHROPIC_API_KEY) | cli (sin llave: usa el Claude Code instalado en el equipo,
# `claude` en el PATH o en ~/.local/bin, con tu sesión iniciada; lo paga la suscripción). Con cli el código vuelve a
# exigir local antes de lanzar `claude`, y Claude Code corre sin herramientas, CLAUDE.md, hooks, skills ni MCP. Cada
# llamada tarda de segundos a minutos: con cli los plazos que esperan a la IA se estiran ×4 (solo en local).
IA_CLAUDE_TRANSPORTE=
# Modelo de Claude (por defecto claude-haiku-5-5; con IA_CLAUDE_TRANSPORTE=cli, el alias haiku).
ANTHROPIC_CHAT_MODEL=
# Profundidad de razonamiento: low | medium | high (por defecto medium; con IA_CLAUDE_TRANSPORTE=cli, low).
IA_LOCAL_ESFUERZO=
# on | off (por defecto on). off apaga el razonamiento adaptativo; solo válido con esfuerzo high o menos.
IA_LOCAL_PENSAMIENTO=

RAG_ENABLED=true
RAG_USE_VECTOR=true
RAG_USE_FULLTEXT=true
RAG_FINAL_LIMIT=15
RAG_USE_TRIGRAM=true
RAG_BRANCH_LIMIT=40
RAG_TRIGRAM_MIN_SIMILARITY=0.3
# Optional Fase 8.2: Python only reorders the already-whitelisted window.
RAG_RERANK_ENABLED=false
RAG_RERANK_CANDIDATE_WINDOW=30
RAG_RERANK_DEADLINE_MS=5000
# Optional online query embeddings via Python. Requires the Python backend flag.
RAG_PYTHON_QUERY_EMBEDDINGS_ENABLED=true

# Python is the only domain backend (ADR-0023): there is no enable flag nor kill
# switch any more; recovery is deploying the previous app + ai-api together.
PYTHON_BACKEND_URL=http://127.0.0.1:8000
INTERNAL_HMAC_SECRET=
# Capacidades de imagen activas por defecto, igual en local y producción, sin
# depender de NODE_ENV. Los valores de abajo son defaults; `=false` apaga una.
# Solo quedan apagadas SCENE_PLAN_V2_SHADOW y GUIA_ESTRUCTURA_V1.
# Patrones de color por estructura (ADR-0028). Al al
# confirmar, Python completa el patrón (foto o preset) y el patrón manda sobre el
# conteo por color. Requiere desplegar juntos la app y ai-api con la edición en
# Python (§9, /internal/v1/plan/edit) y la vista previa (§10).
PATRONES_COLOR_V1=true
# Patrón de color leído en la foto de referencia (ADR-0028 §11). Default ON en
# código: una llamada más a Gemini (vía Python) por foto analizada. Apagado, los
# planes confirmados toman el patrón preset de cada estructura (con
# PATRONES_COLOR_V1 encendida).
PATRON_REFERENCIA_PYTHON_ENABLED=true
# Bouquets por niveles (ADR-0030). BOUQUETS_ARMADO_V1: al confirmar un plan,
# Python arma cada bouquet desde la lectura de la foto o su receta, sin cambiar
# lo que se compra. BOUQUET_REFERENCIA_PYTHON_ENABLED: una llamada más a Gemini
# (vía Python) por foto con bouquets, en paralelo con la del patrón. Default ON.
BOUQUETS_ARMADO_V1=true
BOUQUET_REFERENCIA_PYTHON_ENABLED=true
# Guirnaldas por partes (ADR-0032). GUIRNALDAS_ARMADO_V1: al confirmar un plan,
# Python arma cada guirnalda por receta (soporte, racimos, relleno, remates) sin
# cambiar lo que se compra. Default ON.
GUIRNALDAS_ARMADO_V1=true
# GUIRNALDA_REFERENCIA_PYTHON_ENABLED: una llamada más a Gemini (vía Python) por
# foto con guirnaldas (también arcos y semiarcos), en paralelo con las otras
# lecturas; lee soporte, forma, racimos, relleno y remates. Default ON.
GUIRNALDA_REFERENCIA_PYTHON_ENABLED=true
# Guía de estructura para la imagen (ADR-0033). GUIA_ESTRUCTURA_V1: sin foto del
# espacio y con UNA estructura con armado de guirnalda o patrón, el LoRA recibe
# por /edit el mapa de color plano de esa estructura y su carta de color (dos
# imágenes de entrada más, ~US$ 0,042 estimados por generación). Default OFF.
GUIA_ESTRUCTURA_V1=false
# Guía de escena para la imagen. GUIA_ESCENA_V1: con un plan que salió de una foto de
# referencia, FLUX (modo base o entrenado) recibe por /edit UNA imagen plana con los globos de
# todas las piezas del plan, dibujados por el motor y colocados donde la foto tiene cada pieza.
# La foto del cliente nunca sale hacia fal. Una imagen de entrada más (~US$ 0,021 estimados).
# Si la guía no se puede construir, se genera sin ella y la respuesta lo dice (guiaEscena).
# Default ON.
GUIA_ESCENA_V1=true
# GUIA_ESCENA_SIN_FOTO_V1 (2026-10-07): la misma guía para los planes SIN foto (de texto o de una
# idea del catálogo): cada pieza a su escala real en metros según su ubicación, dibujada por el motor
# (la receta del motor si la pieza no trae armado: lo que enseña la gráfica del plan). Necesita
# GUIA_ESCENA_V1. Default ON (comparación real con FLUX: forma y escala de la pieza respetadas, entorno
# intacto). false = los planes sin foto vuelven a ir solo con texto.
GUIA_ESCENA_SIN_FOTO_V1=true
# Caché en memoria del análisis de la foto (misma foto, mismo prompt). Apagada
# por defecto desde 2026-09-25: cada foto subida se analiza de nuevo (una llamada
# a Gemini). La galería de ejemplos no depende de ella.
REFERENCE_ANALYSIS_CACHE_ENABLED=false
# Modo de presentación (demo del Customer Journey): solo el texto exacto "true" lo
# activa; ausente, vacío o cualquier otro valor lo deja apagado (es lo normal). Mientras
# está activo, para todos los usuarios: no se genera una imagen «de cero» (sin foto de
# referencia ni decoración del catálogo) y la imagen no añade ambientación ni objetos que
# Sempertex no vende. Único lector: src/lib/presentacion/modo-presentacion.ts.
# PRESENTATION_MODE_ENABLED=
# Una sola llamada de visión con las cuatro lecturas (variante v17-lectura-unica).
# Cambia el prompt de análisis congelado de producción (v16, ADR-0029). Encendida,
# las cuatro *_REFERENCIA_PYTHON_ENABLED no se leen. Las lecturas solo sirven si
# su consumidor está encendido (PATRONES_COLOR_V1, BOUQUETS_ARMADO_V1,
# GUIRNALDAS_ARMADO_V1, CONTEO_REFERENCIA_V1): si no, se pagan y se tiran, y el
# arranque lo avisa (`lecturas_sin_consumidor`). Default ON.
LECTURA_UNICA_REFERENCIA_ENABLED=true
# Conteo de globos por estructura leído en la foto (ADR-0031). La lectura y su
# consumidor van en pareja; el consumidor cambia cantidades y precio. Default ON.
CONTEO_REFERENCIA_PYTHON_ENABLED=true
CONTEO_REFERENCIA_V1=true
# Paleta ordenada por píxeles medidos en vez del orden del analizador: cambia qué
# colores compra un plan. Default ON.
MEASURED_COLOR_DOMINANCE_V1=true
# Motor del diseñador (ADR-0034): herramientas de armado y patrón de la foto hacia
# el motor; cambia plan_hash. APAGADA por defecto desde el 2026-10-05 (cambia la
# cotización de los planes nuevos sin aprobar: arco angosto, guirnalda lujosa);
# este `true` es para probarla en local, no para producción.
ARMADO_ARCO_COLUMNA_V1=true
# Herramienta de solo lectura estimar_conteo_globos (ADR-0038).
ESTIMAR_CONTEO_V1=true
# Colores medidos por croquis, solo diagnóstico fuera del blueprint.
ANALISIS_COLOR_SEMPERTEX_V1=true
# Colocación según el venue (fase 6.A) y props de ambiente no cotizados (6.B).
VENUE_AWARE_PLACEMENT_V1=true
AMBIENTE_FIESTA_V1=true
# Llamadas FLUX enrutadas a Python (ADR-0026): solo cambia el transporte;
# el prompt se arma igual. Default OFF.
LORA_GENERATION_PYTHON_ENABLED=false
REFERENCE_ANALYSIS_PYTHON_ENABLED=false
CHAT_PYTHON_ENABLED=false
HAPPIE_PYTHON_ENABLED=false
INTENT_PARSER_PYTHON_ENABLED=false
# Al arrancar, Next y ai-api escriben una línea `banderas_efectivas` con el valor
# real de estas banderas (sin secretos): es la forma de saber qué corre en producción.
PLAN_APPROVAL_SECRET=
PLAN_COST_OPTIMIZER_V2=true
PLAN_BUDGET_GATE_V2=true
# Directorio montado/runtime usado por órdenes admin y pipelines de dataset.
ORDENES_DECORACION_DIR=data/ordenes-decoracion

SCENE_PLAN_V2_SHADOW=false

# --- happie-package-ia ---
HAPPIA_API_BASE_URL=https://www.happia.co/api
HAPPIA_API_KEY=

# Endpoints /api/happie/recommend-package(s) para un consumidor externo
# desde el navegador (no usan la cookie de sesion de la app, ver proxy.ts).
# HAPPIE_EXTERNO_ORIGENES: origenes permitidos separados por coma (sin barra final).
HAPPIE_EXTERNO_API_KEY=
HAPPIE_EXTERNO_ORIGENES=

# Endpoints /api/happie/webhook/recommend-package(s): version server-to-server
# (sin CORS) para que el backend de chat de Happia los llame directo.
# Secreto propio, distinto de HAPPIE_EXTERNO_API_KEY (ese viaja en JS de cliente).
# Minimo 32 caracteres aleatorios. Configurarlo también en la aplicación consumidora.
HAPPIE_WEBHOOK_API_KEY=

# REQ-010: calificación de la IA. Las capturas antes/después van al almacén S3 dedicado (Garage en el VPS, ver
# src/lib/almacen/objetos-s3.ts); sin estas variables las capturas se rechazan con 503 ALMACEN_NO_CONFIGURADO.
ALMACEN_S3_ENDPOINT=
ALMACEN_S3_BUCKET=
ALMACEN_S3_ACCESS_KEY_ID=
ALMACEN_S3_SECRET_ACCESS_KEY=
ALMACEN_S3_REGION=garage
# Clave propia del administrador del feedback de la IA (panel /admin → Feedback IA). Sin ella el panel queda cerrado.
ADMIN_PASSWORD=
# Cron del análisis semanal y de la retención del feedback (GET /api/feedback-ia/analisis-cron con `Authorization: Bearer $CRON_SECRET`); sin él la ruta responde 401.
CRON_SECRET=
# 1 = el cron añade un resumen de Gemini Flash (menos de US$0,02 por corrida).
FEEDBACK_IA_RESUMEN_GEMINI=0
# --- Dictado por voz (REQ-009): Whisper en el VPS ---
# Apagado por defecto. Con VOZ_ENABLED=true el micrófono aparece en las cajas de texto (taller y vista del cliente).
# VOZ_URL y VOZ_SECRETO son solo de servidor: el navegador nunca los ve (solo sabe si está encendido).
# Dentro del contenedor del VPS (red stack_web) se puede usar VOZ_URL=http://voz-decoracion:8000.
VOZ_ENABLED=false
VOZ_URL=https://voz-decoracion.185-147-157-25.sslip.io
VOZ_SECRETO=

# Motor de la vista guiada (REQ-007): python (por defecto) o 3d. Lo manda antes una fila guiada_motor en ajustes_runtime
# y una cookie de administrador. Cambiar esta variable en el VPS exige recrear el contenedor (docker compose up -d web).
# Decide solo los planes NUEVOS: un plan del 3D ya abierto sigue en el 3D aunque vuelva a python (P-045).
GUIADA_MOTOR=python
# Corte del 3D (P-045): activo|inactivo. Freno de emergencia, no la marcha atrás normal: además de los planes nuevos frena
# los del 3D ya abiertos (el cliente lee que su plan se recalcula y que el precio puede cambiar antes de recalcularlo).
# Lo manda antes la fila guiada_motor_corte de ajustes_runtime. Vacío = inactivo.
GUIADA_MOTOR_CORTE=
