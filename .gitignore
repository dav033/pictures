# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# datos y subidas del demo — se generan en runtime, no se versionan
/data/*
!/data/raw/
!/data/quarantine/
!/data/sanitized/
!/data/captions/
!/data/manifests/
/data/raw/*
/data/quarantine/*
/data/sanitized/*
/data/captions/*
!/data/**/.gitkeep
!/data/**/DATASET_CARD.md
# Análisis derivado que consume la pantalla de configuración del LoRA
!/data/processed/
/data/processed/*
!/data/processed/lora-v004-composicion.json

# Anotaciones + captions de v007 que lee training-reference-counts.ts en
# runtime (botón "N referencias en entrenamiento"). Sin versionarlas, esa
# función siempre devuelve cero fuera de un checkout local con el staging
# completo — no hay forma de que un deploy las traiga si no están en git.
# Se listan explícitamente solo lo que el código realmente lee; el resto de
# data/staging/lora-v007 (logs, reportes de corrida, config) sigue ignorado.
!/data/staging/
/data/staging/*
!/data/staging/lora-v007/
/data/staging/lora-v007/*
!/data/staging/lora-v007/anotaciones/
!/data/staging/lora-v007/captions/
!/data/staging/lora-v007/aprobadas.json

/public/uploads

# typescript
*.tsbuildinfo
next-env.d.ts

# paquetes del workspace — build output
packages/*/dist

# perfiles persistentes de navegador para scrapers con sesión propia (Playwright)
/.playwright-profiles/

# renders de depuración/evaluación del LoRA — no aportan al código, se regeneran
/reports/lora-debug/
