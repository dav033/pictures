# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Copia de .env.local con valores de ejemplo (sin secretos reales)
!.env.local.example

# vercel
.vercel

# datos y subidas del demo — se generan en runtime, no se versionan
/data/*
!/data/raw/
!/data/quarantine/
!/data/sanitized/
!/data/captions/
!/data/manifests/
# Nombres reales de clientes y URLs de sus fotos (lo genera `ordenes:index`):
# vive solo en la máquina que lo arma, nunca en git.
/data/manifests/revie-reviews-index.json
/data/raw/*
/data/quarantine/*
/data/sanitized/*
/data/captions/*
!/data/**/.gitkeep
!/data/**/DATASET_CARD.md
# Análisis derivado que consume la pantalla de configuración del LoRA
!/data/processed/
/data/processed/*
!/data/processed/lora-v004-composicion.json

# Anotaciones + captions de v007 que lee training-reference-counts.ts en
# runtime (botón "N referencias en entrenamiento"). Sin versionarlas, esa
# función siempre devuelve cero fuera de un checkout local con el staging
# completo — no hay forma de que un deploy las traiga si no están en git.
# Se listan explícitamente solo lo que el código realmente lee; el resto de
# data/staging/lora-v007 (logs, reportes de corrida, config) sigue ignorado.
!/data/staging/
/data/staging/*
!/data/staging/lora-v007/
/data/staging/lora-v007/*
!/data/staging/lora-v007/anotaciones/
!/data/staging/lora-v007/captions/
!/data/staging/lora-v007/aprobadas.json
!/data/staging/lora-v007/conceptos-propuestos.json

/public/uploads

# typescript
*.tsbuildinfo
next-env.d.ts

# paquetes del workspace — build output
packages/*/dist

# Servicio Python: entornos y cachés locales, nunca artefactos de runtime.
/services/ai-api/.venv/
/services/ai-api/.pytest_cache/
/services/ai-api/.mypy_cache/
/services/ai-api/**/__pycache__/
/services/ai-api/*.egg-info/

# perfiles persistentes de navegador para scrapers con sesión propia (Playwright)
/.playwright-profiles/

# Output of the benchmark, evaluation and diagnostic scripts. None of it is
# versioned: the scripts regenerate it on demand.
/reports/
/informes/
