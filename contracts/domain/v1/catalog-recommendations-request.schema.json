{
  "$id": "catalog-recommendations.v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "catalog-recommendations.v1"
    },
    "catalog_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "reference_variant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "lora_variant_ids": {
      "minItems": 1,
      "maxItems": 2048,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "schema_version",
    "catalog_snapshot_id",
    "reference_variant_id",
    "limit"
  ],
  "additionalProperties": false
}
