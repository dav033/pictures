{
  "$id": "happie-error.v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "happie.v1"
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "campos": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "error"
  ],
  "additionalProperties": false
}
