{
  "$id": "reference-blueprint.v2",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "source_images": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "approved_roles": {
            "minItems": 1,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "composition_reference",
                "element_reference",
                "palette_reference",
                "style_reference",
                "catalog_product_reference",
                "venue_base"
              ]
            }
          }
        },
        "required": [
          "image_id",
          "approved_roles"
        ],
        "additionalProperties": false
      }
    },
    "elements": {
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "source_image_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "category": {
            "type": "string",
            "enum": [
              "curtain",
              "drape",
              "backdrop",
              "panel",
              "balloon_structure",
              "plinth",
              "furniture",
              "floral",
              "signage",
              "lighting",
              "tableware",
              "other"
            ]
          },
          "scene_role": {
            "type": "string",
            "enum": [
              "backdrop",
              "midground",
              "foreground",
              "accent",
              "lighting"
            ]
          },
          "detection_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "visible_evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          },
          "reference_bbox": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "depth_layer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "include_policy": {
            "type": "string",
            "enum": [
              "include",
              "exclude",
              "ask"
            ]
          },
          "approved": {
            "type": "boolean"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "catalog_backed",
              "reference_only"
            ]
          },
          "quantity": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "exact",
                  "approximate",
                  "range"
                ]
              },
              "min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 999
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 999
              }
            },
            "required": [
              "mode",
              "min",
              "max"
            ],
            "additionalProperties": false
          },
          "appearance": {
            "type": "object",
            "properties": {
              "observed_colors": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "resolved_colors": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "color_policy": {
                "type": "string",
                "enum": [
                  "match_reference",
                  "adapt_to_event_palette",
                  "custom"
                ]
              },
              "material": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "shape": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "composition": {
                "default": "single uniform material",
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "observed_colors",
              "resolved_colors",
              "color_policy",
              "material",
              "shape",
              "composition"
            ],
            "additionalProperties": false
          },
          "relationships": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "behind",
                    "in_front_of",
                    "overlaps",
                    "aligned_with",
                    "supports"
                  ]
                },
                "target_element_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "required": [
                "type",
                "target_element_id"
              ],
              "additionalProperties": false
            }
          },
          "visual_semantics": {
            "type": "object",
            "properties": {
              "structure_type": {
                "type": "string",
                "enum": [
                  "arco",
                  "semiarco",
                  "guirnalda",
                  "columna",
                  "pared",
                  "centro_mesa",
                  "backdrop",
                  "kit",
                  "accesorio",
                  "escultura"
                ]
              },
              "placement": {
                "type": "string",
                "enum": [
                  "fondo_pared",
                  "sobre_mesa_principal",
                  "lateral_izquierdo",
                  "lateral_derecho",
                  "piso_frontal",
                  "mesas_invitados",
                  "entrada",
                  "techo",
                  "arco_central",
                  "zona_central",
                  "fachada",
                  "pared_lateral",
                  "alrededor_mobiliario",
                  "vegetacion",
                  "techo_multipunto",
                  "recorrido_suelo",
                  "esquina"
                ]
              },
              "design_role": {
                "type": "string",
                "enum": [
                  "focal",
                  "soporte",
                  "acento"
                ]
              },
              "repetition_group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "dimensions_m": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  },
                  "length": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  }
                },
                "additionalProperties": false
              },
              "density": {
                "type": "string",
                "enum": [
                  "sencilla",
                  "media",
                  "lujosa"
                ]
              }
            },
            "required": [
              "structure_type",
              "placement",
              "design_role",
              "repetition_group",
              "density"
            ],
            "additionalProperties": false
          },
          "element_kind": {
            "type": "string",
            "enum": [
              "balloon_structure",
              "catalog_prop",
              "backdrop"
            ]
          },
          "quantity_semantics": {
            "type": "string",
            "enum": [
              "material_units",
              "physical_instances"
            ]
          },
          "physical_form": {
            "type": "object",
            "properties": {
              "categoria_sujeto": {
                "type": "string",
                "enum": [
                  "animal",
                  "personaje",
                  "numero",
                  "letra",
                  "objeto",
                  "simbolo",
                  "forma_tematica"
                ]
              },
              "sujeto": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "descripcion_perceptual_en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "partes": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "parte_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "funcion": {
                      "type": "string",
                      "enum": [
                        "volumen_principal",
                        "extremidad",
                        "detalle",
                        "base",
                        "conexion"
                      ]
                    },
                    "descriptor_perceptual_en": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "variant_ids": {
                      "minItems": 1,
                      "maxItems": 12,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      }
                    }
                  },
                  "required": [
                    "parte_id",
                    "funcion",
                    "descriptor_perceptual_en",
                    "variant_ids"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "categoria_sujeto",
              "sujeto",
              "descripcion_perceptual_en",
              "partes"
            ],
            "additionalProperties": false
          },
          "catalog_visual": {
            "type": "object",
            "properties": {
              "descriptor_perceptual_en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 420
              },
              "pattern": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "motif": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  },
                  "text_policy": {
                    "default": "none",
                    "type": "string",
                    "enum": [
                      "none",
                      "graphic_lettering",
                      "exact_approved"
                    ]
                  },
                  "approved_text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "evidence_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  }
                },
                "required": [
                  "kind",
                  "text_policy"
                ],
                "additionalProperties": false
              },
              "concept_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "required": [
              "descriptor_perceptual_en",
              "pattern"
            ],
            "additionalProperties": false
          },
          "physical_relations": {
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "relacion": {
                  "type": "string",
                  "enum": [
                    "enmarcar",
                    "trepar_por",
                    "envolver",
                    "colgar_de",
                    "derramarse_sobre",
                    "montar_sobre",
                    "apoyarse_en",
                    "conectar_con",
                    "quedar_detras_de",
                    "quedar_debajo_de"
                  ]
                },
                "target": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "ancla_espacio"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "elemento_plan"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "prioridad": {
                  "type": "string",
                  "enum": [
                    "primaria",
                    "secundaria"
                  ]
                },
                "distribucion": {
                  "type": "string",
                  "enum": [
                    "continua",
                    "asimetrica",
                    "en_racimos",
                    "multipunto",
                    "alturas_escalonadas",
                    "recorrido"
                  ]
                }
              },
              "required": [
                "relacion",
                "target",
                "prioridad"
              ],
              "additionalProperties": false
            }
          },
          "resolved_finishes": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "uncertainties": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            }
          },
          "model_decision": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "include",
                  "omit"
                ]
              },
              "catalog_product_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "match_type": {
                "type": "string",
                "enum": [
                  "exact",
                  "closest",
                  "none"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 260
              },
              "adaptation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 260
              },
              "bill_of_materials": {
                "maxItems": 24,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "catalog_product_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "share": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "catalog_product_id",
                    "role",
                    "share"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "action",
              "match_type",
              "reason",
              "adaptation"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "element_id",
          "source_image_id",
          "name",
          "category",
          "scene_role",
          "detection_confidence",
          "visible_evidence",
          "reference_bbox",
          "depth_layer",
          "include_policy",
          "approved",
          "source_type",
          "quantity",
          "appearance",
          "relationships",
          "uncertainties"
        ],
        "additionalProperties": false
      }
    },
    "composition": {
      "type": "object",
      "properties": {
        "focal_point": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "density": {
          "type": "string",
          "enum": [
            "sparse",
            "moderate",
            "dense",
            "unknown"
          ]
        },
        "symmetry": {
          "type": "string",
          "enum": [
            "symmetric",
            "asymmetric",
            "unknown"
          ]
        },
        "negative_space": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "required": [
        "focal_point",
        "density",
        "symmetry",
        "negative_space"
      ],
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "properties": {
        "observed": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "priority": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "required": [
        "observed",
        "priority"
      ],
      "additionalProperties": false
    },
    "unresolved_decisions": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "element_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "decision_id",
          "element_id",
          "question"
        ],
        "additionalProperties": false
      }
    },
    "anchors": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "anchor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "tipo": {
            "type": "string",
            "enum": [
              "puerta",
              "pared",
              "mesa",
              "arbol",
              "techo",
              "piso",
              "fachada",
              "esquina",
              "mobiliario_existente"
            ]
          },
          "evidencia": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "bbox": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "anchor_id",
          "tipo",
          "evidencia"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_images",
    "elements",
    "composition",
    "palette",
    "unresolved_decisions"
  ],
  "additionalProperties": false
}
