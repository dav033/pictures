{
  "$id": "catalog-search-result.v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "operation_schema_version": {
      "type": "string",
      "const": "catalog-search-result.v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "OK",
        "NO_MATCH",
        "AMBIGUOUS_SKU"
      ]
    },
    "sku_status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "not_sku",
            "unique",
            "ambiguous",
            "not_found",
            "filtered_out"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "candidates": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "finishes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "occasions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "available": {
            "type": "boolean"
          },
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "score": {
            "type": "number"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "variant_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "sku": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "title": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "price": {
                  "type": "number",
                  "minimum": 0
                },
                "available": {
                  "type": "boolean"
                },
                "size_code": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "diameter_inches": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "shape": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "colors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "variant_id",
                "sku",
                "title",
                "price",
                "available",
                "size_code",
                "diameter_inches",
                "shape",
                "colors"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "product_id",
          "title",
          "category",
          "colors",
          "finishes",
          "occasions",
          "available",
          "image",
          "score",
          "variants"
        ],
        "additionalProperties": false
      }
    },
    "whitelist": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "variant_ids": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        "required": [
          "product_id",
          "variant_ids"
        ],
        "additionalProperties": false
      }
    },
    "catalog_snapshot_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "latency_parse_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latency_retrieval_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "operation_schema_version",
    "status",
    "sku_status",
    "candidates",
    "whitelist",
    "catalog_snapshot_id",
    "latency_parse_ms",
    "latency_retrieval_ms"
  ],
  "additionalProperties": false
}
