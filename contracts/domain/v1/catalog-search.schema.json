{
  "$id": "catalog-search.v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "catalog-search.v1"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "filters": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "price_max": {
          "type": "number",
          "minimum": 0
        },
        "categories": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "occasions": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "colors": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "finishes": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "shapes": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "diameters_inches": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "allowlist": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "variant_ids": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        "required": [
          "product_id",
          "variant_ids"
        ],
        "additionalProperties": false
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "catalog_snapshot_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "message",
    "filters",
    "allowlist",
    "limit"
  ],
  "additionalProperties": false,
  "x-tonos-colores-catalogo": {
    "hues": {
      "rojo": 0,
      "burdeos": 350,
      "coral": 12,
      "naranja": 30,
      "dorado": 44,
      "dorado rosa": 12,
      "champagne": 42,
      "amarillo": 52,
      "cafe": 28,
      "beige": 38,
      "crema": 48,
      "nude": 24,
      "verde": 120,
      "menta": 155,
      "turquesa": 180,
      "azul": 220,
      "lila": 270,
      "violeta": 276,
      "morado": 280,
      "fucsia": 320,
      "rosado": 335
    },
    "familias_neutras": [
      [
        "blanco",
        "crema",
        "beige",
        "nude",
        "transparente"
      ],
      [
        "plateado",
        "gris",
        "negro"
      ],
      [
        "dorado",
        "champagne"
      ]
    ],
    "puntuacion_familia": 0.35
  }
}
